{
  "name": "neuz-maison",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun --bun next dev --hostname 127.0.0.1",
    "build": "bun --bun next build",
    "start": "bun --bun next start --hostname 127.0.0.1",
    "lint": "bun --bun eslint .",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test ./tests",
    "test:browser": "bun scripts/interaction-check.mjs && bun scripts/visual-check.mjs",
    "assets": "bun scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/noto-sans-arabic": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "next-intl": "^4.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.9.0",
    "sharp": "^0.35.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
