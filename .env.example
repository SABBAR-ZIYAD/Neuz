# Public production origin. Leave unset for local development (no indexing).
SITE_URL=
# Resend must verify this sender's domain. Gmail is the recipient, never the sender.
RESEND_API_KEY=
RESEND_FROM=NEUZ <devis@your-verified-domain.com>
# Optional Cloudflare Turnstile. Both keys must be configured together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
