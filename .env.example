# Canonical production origin. Netlify/Vercel previews automatically remain noindex.
SITE_URL=https://neuz.ma
# Resend must verify this sender's domain. Gmail is the recipient, never the sender.
RESEND_API_KEY=
RESEND_FROM=NEUZ <devis@your-verified-domain.com>
# Required on hosted environments for quotes and admin login. Configure both keys together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only Supabase credentials. Run supabase/admin.sql before deploying.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate local admin credentials with bun run admin:setup. Copy these values to hosting.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Local development only; never set local storage on Netlify or Vercel.
CATALOG_STORAGE=
CATALOG_DATA_DIR=

# Shared quote protection: apply supabase/quote-limits.sql and quote-email-quota.sql.
# Dedicated stable secret (32+ characters); falls back to ADMIN_SESSION_SECRET.
QUOTE_RATE_LIMIT_SECRET=
# Other hosts only: Netlify and Vercel select their trusted IP headers automatically.
QUOTE_TRUSTED_IP_HEADER=
# Rolling 24-hour / 31-day send-attempt budgets; maximum 100 / 3000.
QUOTE_EMAIL_DAILY_LIMIT=90
QUOTE_EMAIL_MONTHLY_LIMIT=2700

# Extra exact HTTPS preview origins, comma separated. Netlify deployment URLs and Vercel previews are automatic.
TRUSTED_PREVIEW_ORIGINS=
# Optional general trusted single-IP ingress header; supersedes QUOTE_TRUSTED_IP_HEADER.
TRUSTED_CLIENT_IP_HEADER=
# Set true to prevent indexing before launch or on other preview hosts.
SITE_NOINDEX=
